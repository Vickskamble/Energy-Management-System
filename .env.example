# EMS Configuration
# Copy this file to .env and fill in your keys

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: where Supabase redirects after email confirm / password reset.
# Web builds auto-detect their own origin, so this is only needed to pin a
# specific URL. MUST also be whitelisted in Supabase Dashboard →
# Authentication → URL Configuration → Redirect URLs.
# APP_REDIRECT_URL=https://your-app.example.com
